.DS_Store
.dotfiles-backup/

# Keep local fish credentials and generated universal variables out of the repository.
/config/fish/secrets.fish
/config/fish/fish_variables

# Herdr keeps logs, sockets, and session data beside its config.
/config/herdr/*
!/config/herdr/config.toml

# macOS metadata
.DS_Store

# Harness keeps credentials and lock files beside its config.
/config/harness/*
!/config/harness/config.toml
