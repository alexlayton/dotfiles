[init]
    defaultBranch = main

[core]
    editor = code --wait
    # Set this once you know what you want, e.g.:
    # excludesfile = ~/.gitignore_global

[push]
    default = simple

[pull]
    rebase = false

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

